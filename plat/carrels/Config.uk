menuconfig PLAT_CARRELS
	bool "CARRELS guest"
	default n
	depends on (ARCH_ARM_64)
	imply LIBUKPM
	imply LIBUKPSCI if ARCH_ARM_64
	select LIBUKDEBUG
	select LIBUKBOOT
	select LIBUKBITOPS
	select LIBUKALLOC
	select LIBUKTIMECONV
	select LIBNOLIBC if !HAVE_LIBC
	select HAVE_FDT if ARCH_ARM_64
	imply LIBFDT if ARCH_ARM_64
	imply LIBUKOFW if ARCH_ARM_64
	select LIBUKRELOC if OPTIMIZE_PIE
	select HAVE_PAGING
	select LIBUKPLAT_NATIVE_PAL
	select LIBUKPLAT_NATIVE_PAGING if LIBUKPAGING
	select LIBUKPLAT_NATIVE_LCPU_PM if LIBUKLCPU
	select HAVE_INTCTLR
	imply LIBUKBUS_PLATFORM if ARCH_ARM_64
	imply LIBVIRTIO_9P if LIBUK9P
	imply LIBVIRTIO_NET if LIBUKNETDEV
	imply LIBVIRTIO_BLK if LIBUKBLKDEV
	imply LIBUKRANDOM_LCPU if LIBUKRANDOM
	help
		Create a Unikraft image that runs as a CARRELS guest

if (PLAT_CARRELS)

choice
	prompt "Boot protocol"
	default CARRELS_BOOT_TEMPALTE_PD

config CARRELS_BOOT_TEMPALTE_PD
	bool "Template PD"
	depends on ARCH_ARM_64
	help
		Carrels template PD Boot Protocol

choice
	prompt "Virtual Machine Monitor"
	default CARRELS_VMM_DEFAULT

config CARRELS_VMM_DEAULT
	bool "DEFAULT"
	imply LIBPL011 if LIBUKCONSOLE && ARCH_ARM_64
	imply LIBPL011_EARLY_CONSOLE if LIBUKCONSOLE && ARCH_ARM_64
	imply LIBUKINTCTLR_GICV2 if ARCH_ARM_64
	imply LIBUKRTC_PL031
	select HAVE_PCI
	select HAVE_MMIO

endchoice
endif

