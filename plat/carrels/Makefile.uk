LIBCARRELSPLAT_BASE := $(CONFIG_UK_BASE)/plat/carrels

$(eval $(call addplat_s,carrels,$(CONFIG_PLAT_CARRELS)))
$(eval $(call addplatlib,carrels,libcarrelsplat))

ASINCLUDES-$(CONFIG_PLAT_CARRELS)  += \
	-I$(LIBCARRELSPLAT_BASE)/pal/include
CINCLUDES-$(CONFIG_PLAT_CARRELS)   += \
	-I$(LIBCARRELSPLAT_BASE)/pal/include
CXXINCLUDES-$(CONFIG_PLAT_CARRELS) += \
	-I$(LIBCARRELSPLAT_BASE)/pal/include

LIBCARRELSPLAT_SRCS-y += \
	$(UK_PLAT_COMMON_BASE)/bootinfo.c|common
LIBCARRELSPLAT_SRCS-y += \
	$(UK_PLAT_COMMON_BASE)/memory.c|common
LIBCARRELSPLAT_SRCS-y += \
	$(UK_PLAT_COMMON_BASE)/bootinfo.lds.S|common

LIBCARRELSPLAT_CINCLUDES-y += \
	-I$(UK_PLAT_COMMON_BASE)/include
LIBCARRELSPLAT_ASINCLUDES-y += \
	-I$(UK_PLAT_COMMON_BASE)/include


UK_PLAT_CARRELS_DEF_LDS := \
	$(CONFIG_UK_BASE)/plat/carrels/link64.lds.S

LIBCARRELSPLAT_CINCLUDES-y  += -I$(LIBCARRELSPLAT_BASE)/include
LIBCARRELSPLAT_ASINCLUDES-y += -I$(LIBCARRELSPLAT_BASE)/include

LIBCARRELSPLAT_CFLAGS-y     += -DCARRELSPLAT
LIBCARRELSPLAT_CXXFLAGS-y   += -DCARRELSPLAT
LIBCARRELSPLAT_ASFLAGS-y    += -DCARRELSPLAT

LIBCARRELSPLAT_SRCS-y += $(UK_PLAT_CARRELS_DEF_LDS)
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/pal/ctx.S
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/entry.c
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/pal/except.c
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/memory.c
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/time.c
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/lcpu_pm.c
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/events.c
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/sched_events.c
LIBCARRELSPLAT_SRCS-y += $(LIBCARRELSPLAT_BASE)/random.c

LIBCARRELSPLAT_SRCS-$(CONFIG_LIBUKNETDEV) += \
	$(LIBCARRELSPLAT_BASE)/netdev.c
