CARRELS_LDFLAGS-y += -Wl,-m,aarch64elf
CARRELS_LDLIBS-y += -lgcc

CARRELS_VMM := default

ifneq ($(UK_IMAGE_NAME_OVERWRITE),)
CARRELS_IMAGE := $(BUILD_DIR)/$(UK_IMAGE_NAME_OVERWRITE)
else
CARRELS_IMAGE := $(BUILD_DIR)/$(CONFIG_UK_NAME)_$(CARRELS_VMM)-$(CONFIG_UK_ARCH)
endif
CARRELS_DEBUG_IMAGE := $(CARRELS_IMAGE).dbg
CARRELS_COMPILE_DB_IMAGE := $(BUILD_DIR)/compile_commands.json

CARRELS_LD_SCRIPT_FLAGS := $(addprefix -Wl$(comma)-dT$(comma),\
			 $(UK_PLAT_CARRELS_DEF_LDS))
CARRELS_LD_SCRIPT_FLAGS += $(addprefix -Wl$(comma)-T$(comma),\
			$(CARRELS_LD_SCRIPT-y) $(EXTRA_LD_SCRIPT-y))

$(CARRELS_DEBUG_IMAGE): $(CARRELS_ALIBS) $(CARRELS_ALIBS-y) $(CARRELS_OLIBS) $(CARRELS_OLIBS-y) \
		    $(UK_ALIBS) $(UK_ALIBS-y) $(UK_OLIBS) $(UK_OLIBS-y) \
		    $(CARRELS_LD_SCRIPT-y) $(EXTRA_LD_SCRIPT-y) \
		    $(UK_PLAT_CARRELS_DEF_LDS) $(UK_LDEPS)
	$(call build_cmd,LD,,$@,\
	       $(LD) \
			$(CARRELS_LDFLAGS) $(CARRELS_LDFLAGS-y) \
			$(CARRELS_OLIBS) $(CARRELS_OLIBS-y) \
			$(UK_OLIBS) $(UK_OLIBS-y) \
			-Wl$(comma)--start-group \
			$(CARRELS_ALIBS) $(CARRELS_ALIBS-y) \
			$(UK_ALIBS) $(UK_ALIBS-y) \
			-Wl$(comma)--end-group \
			$(CARRELS_LDLIBS) $(CARRELS_LDLIBS-y) \
			$(LDFLAGS) $(LDFLAGS-y) \
			$(CARRELS_LD_SCRIPT_FLAGS) \
			-o $@)
ifeq ($(CONFIG_OPTIMIZE_PIE),y)
	$(call build_uk_reloc,$@)
endif
ifeq ($(CONFIG_LIBUKPCPUVAR),y)
	$(call build_uk_pcpuvar,$@)
endif

$(CARRELS_IMAGE): $(CARRELS_IMAGE).dbg
	$(call build_cmd,SCSTRIP,,$@,\
		$(STRIP) --strip-debug \
			$(SECT_STRIP_FLAGS) $(SECT_STRIP_FLAGS-y) \
			$(CARRELS_STRIPFLAGS) \
			$< -o $@ 2>&1 | \
			{ $(GREP) -Ev \
				"Empty loadable segment detected|section.*lma.*adjusted to.*" || \
				true; })
	$(call build_bootinfo,$@)

$(CARRELS_IMAGE).sym: $(CARRELS_DEBUG_IMAGE)
	$(call build_cmd,NM,,$@, $(NM) -n $< > $@)

$(CARRELS_IMAGE).gz: $(CARRELS_IMAGE)
	$(call build_cmd,GZ,,$@, $(GZIP) -f -9 -c $< >$@)

$(CARRELS_COMPILE_DB_IMAGE): $(CARRELS_IMAGE)
	$(call build_compile_db,$(BUILD_DIR),$@)

# register images to the build
ifeq ($(CONFIG_PLAT_CARRELS),y)
UK_DEBUG_IMAGES-y                     += $(CARRELS_DEBUG_IMAGE)
UK_IMAGES-y                           += $(CARRELS_IMAGE)
UK_IMAGES-$(CONFIG_OPTIMIZE_SYMFILE)  += $(CARRELS_IMAGE).sym
UK_IMAGES-$(CONFIG_OPTIMIZE_COMPRESS) += $(CARRELS_IMAGE).gz
UK_IMAGES-y                           += $(CARRELS_COMPILE_DB_IMAGE)
endif

# ...for cleaning:
LIBCARRELSPLAT_CLEAN += $(call build_clean,$(CARRELS_DEBUG_IMAGE).bootinfo)
